{
  "name": "er-diagram",
  "args": ["{{DB}}", "--open-model", "--window-size", "1400x900"],
  "steps": [
    {"op": "waitFor", "probe": "tabKind", "equals": "model"},
    {"op": "waitFor", "probe": "tab.model.tables.count", "atLeast": 2, "note": "schema read"},
    {"op": "wait", "ms": 600, "note": "zoom to fit applied"},
    {"op": "screenshot", "name": "start"},
    {"op": "click", "view": "ERCanvasView", "anchor": "table:customers", "note": "select a card"},
    {"op": "waitFor", "probe": "tab.selection", "contains": "customers"},
    {"op": "waitFor", "label": "customers: 5 fields, 1 relationship", "exists": true, "note": "toolbar summary of the selection"},
    {"op": "click", "view": "ERCanvasView", "anchor": "empty", "note": "click the background clears the selection"},
    {"op": "waitFor", "probe": "tab.selection", "equals": "nil"},
    {"op": "remember", "as": "frames", "view": "ERCanvasView"},
    {"op": "drag", "from": {"view": "ERCanvasView", "anchor": "table:orders"}, "by": [140, 90], "note": "drag a card"},
    {"op": "assert", "view": "ERCanvasView", "notEquals": "$frames"},
    {"op": "assert", "probe": "tab.selection", "contains": "orders", "note": "dragging selects the card"},
    {"op": "screenshot", "name": "moved"},
    {"op": "remember", "as": "zoom", "probe": "tab.zoom"},
    {"op": "click", "id": "plus.magnifyingglass", "note": "Zoom In"},
    {"op": "waitFor", "probe": "tab.zoom", "notEquals": "$zoom"},
    {"op": "remember", "as": "zoom2", "probe": "tab.zoom"},
    {"op": "magnify", "view": "ERCanvasView", "anchor": "card:customers", "amount": -0.3, "note": "pinch out"},
    {"op": "wait", "ms": 300},
    {"op": "waitFor", "probe": "tab.zoom", "notEquals": "$zoom2", "note": "the pinch is kept in the model (not reset on the next update)"},
    {"op": "remember", "as": "zoom3", "probe": "tab.zoom"},
    {"op": "key", "key": "-", "modifiers": ["cmd"], "note": "⌘- zooms out"},
    {"op": "waitFor", "probe": "tab.zoom", "notEquals": "$zoom3"},
    {"op": "click", "id": "arrow.up.left.and.down.right.magnifyingglass", "note": "Zoom to Fit"},
    {"op": "wait", "ms": 400},
    {"op": "rightClick", "view": "ERCanvasView", "anchor": "table:customers", "menu": ["Generate SQL…"], "note": "card context menu"},
    {"op": "waitFor", "sheet": true, "equals": "true"},
    {"op": "screenshot", "name": "generate-sql"},
    {"op": "click", "label": "Close", "role": "button", "window": "sheet"},
    {"op": "waitFor", "sheet": true, "equals": "false"},
    {"op": "doubleClick", "view": "ERCanvasView", "anchor": "table:customers", "note": "double-click opens the table"},
    {"op": "waitFor", "probe": "tabKind", "equals": "table"},
    {"op": "assert", "probe": "tabTitle", "contains": "customers"}
  ]
}
