{
  "name": "grid",
  "args": ["{{DB}}", "--open-table", "customers", "--window-size", "1400x900"],
  "steps": [
    {"op": "waitFor", "probe": "tab.rowCount", "atLeast": 20, "note": "rows loaded"},
    {"op": "click", "view": "GridTableView", "anchor": "cell:0,2", "note": "select a cell"},
    {"op": "waitFor", "probe": "tab.focusedCell.row", "equals": 0},
    {"op": "wait", "ms": 700, "note": "past the double-click interval"},
    {"op": "doubleClick", "view": "GridTableView", "anchor": "cell:1,2", "note": "double-click edits the cell"},
    {"op": "wait", "ms": 400},
    {"op": "key", "key": "a", "modifiers": ["cmd"]},
    {"op": "type", "text": "Edited by scenario"},
    {"op": "key", "key": "return"},
    {"op": "waitFor", "probe": "tab.value:1,1", "contains": "Edited by scenario"},
    {"op": "assert", "probe": "tab.changeCount", "equals": 1},
    {"op": "screenshot", "name": "edited"},
    {"op": "click", "view": "GridTableView", "anchor": "cell:2,3"},
    {"op": "key", "key": "return", "modifiers": ["opt"], "note": "⌥↩ opens the value editor"},
    {"op": "waitFor", "probe": "popover", "equals": "true", "note": "the value editor popover"},
    {"op": "screenshot", "name": "value-editor"},
    {"op": "key", "key": "escape"},
    {"op": "waitFor", "probe": "popover", "equals": "false"},
    {"op": "rightClick", "view": "GridTableView", "anchor": "cell:3,2", "menu": ["Duplicate Record"], "note": "context menu → Duplicate Record"},
    {"op": "waitFor", "probe": "tab.insertedRows.count", "equals": 1},
    {"op": "remember", "as": "last", "probe": "tab.lastRow"},
    {"op": "wait", "ms": 700},
    {"op": "doubleClick", "view": "GridTableView", "anchor": "cell:$last,3", "note": "give the copy a unique email"},
    {"op": "wait", "ms": 400},
    {"op": "key", "key": "a", "modifiers": ["cmd"]},
    {"op": "type", "text": "copy@example.com"},
    {"op": "key", "key": "return"},
    {"op": "waitFor", "probe": "tab.value:$last,2", "contains": "copy@example.com", "optional": true},
    {"op": "rightClick", "view": "GridTableView", "anchor": "cell:4,2", "menu": ["Copy As", "CSV"], "note": "context menu → Copy As › CSV"},
    {"op": "waitFor", "probe": "pasteboard", "contains": "Customer 5"},
    {"op": "rightClick", "view": "GridTableView", "anchor": "cell:5,4", "menu": ["Set to NULL"]},
    {"op": "waitFor", "probe": "tab.changeCount", "equals": 3},
    {"op": "key", "key": "s", "modifiers": ["cmd"], "note": "⌘S applies the pending changes"},
    {"op": "waitFor", "probe": "tab.changeCount", "equals": 0},
    {"op": "assert", "probe": "tab.saveError", "equals": "nil"},
    {"op": "assert", "probe": "tab.value:1,1", "contains": "Edited by scenario"},
    {"op": "remember", "as": "columns", "view": "GridTableView"},
    {"op": "drag", "from": {"view": "GridTableView", "anchor": "headerEdge:name"}, "by": [80, 0], "note": "resize the name column"},
    {"op": "assert", "view": "GridTableView", "notEquals": "$columns"},
    {"op": "remember", "as": "columns2", "view": "GridTableView"},
    {"op": "drag", "from": {"view": "GridTableView", "anchor": "header:email"}, "to": {"view": "GridTableView", "anchor": "header:name"}, "steps": 20, "note": "drag the email column before name"},
    {"op": "assert", "view": "GridTableView", "notEquals": "$columns2"},
    {"op": "screenshot", "name": "columns"},
    {"op": "remember", "as": "scrolled", "view": "GridTableView"},
    {"op": "scroll", "view": "GridTableView", "dy": -3000, "ticks": 10, "note": "scroll wheel down the grid"},
    {"op": "wait", "ms": 300},
    {"op": "assert", "view": "GridTableView", "notEquals": "$scrolled", "note": "rows scrolled"}
  ]
}
