{
  "name": "grid-type-to-edit",
  "args": ["{{DB}}", "--open-table", "customers", "--window-size", "1400x900"],
  "steps": [
    {"op": "waitFor", "probe": "tab.rowCount", "atLeast": 20},
    {"op": "click", "view": "GridTableView", "anchor": "cell:1,2", "note": "focus a cell"},
    {"op": "wait", "ms": 300},
    {"op": "type", "text": "Xyz", "note": "typing replaces its value, as in a spreadsheet (the first key starts editing)"},
    {"op": "key", "key": "return"},
    {"op": "waitFor", "probe": "tab.value:1,1", "equals": "text(\"Xyz\")", "timeout": 3}
  ]
}
