{
  "name": "interface-mode",
  "args": ["{{DB}}", "--first-launch", "--window-size", "1400x900"],
  "steps": [
    {"op": "waitFor", "probe": "onboarding", "equals": "true", "note": "first launch shows the welcome sheet"},
    {"op": "waitFor", "id": "onboarding.card.advanced", "exists": true},
    {"op": "assert", "probe": "interfaceMode", "equals": "advanced", "note": "Advanced is preselected"},
    {"op": "assert", "probe": "onboardingDone", "equals": "false"},
    {"op": "wait", "ms": 400},
    {"op": "screenshot", "name": "onboarding"},
    {"op": "key", "key": "right", "note": "→ moves the choice to Simple"},
    {"op": "key", "key": "return", "note": "Return continues"},
    {"op": "waitFor", "probe": "onboarding", "equals": "false"},
    {"op": "assert", "probe": "interfaceMode", "equals": "simple"},
    {"op": "assert", "probe": "onboardingDone", "equals": "true"},
    {"op": "waitFor", "probe": "openSessions", "equals": 1},
    {"op": "waitFor", "label": "Automation", "window": "main", "exists": false, "note": "Simple toolbar"},
    {"op": "assert", "label": "Model", "window": "main", "exists": false},
    {"op": "assert", "label": "Backup", "window": "main", "exists": false},
    {"op": "assert", "label": "Trigger", "window": "main", "exists": false},
    {"op": "assert", "label": "New Query", "window": "main", "exists": true},
    {"op": "assert", "label": "Table", "window": "main", "exists": true},
    {"op": "assert", "label": "View", "window": "main", "exists": true},
    {"op": "assert", "label": "Query", "window": "main", "exists": true},
    {"op": "wait", "ms": 400},
    {"op": "screenshot", "name": "simple"},
    {"op": "click", "id": "toolbar.account", "note": "avatar"},
    {"op": "waitFor", "id": "account.theme", "exists": true},
    {"op": "wait", "ms": 300},
    {"op": "screenshot", "name": "account-popover"},
    {"op": "click", "id": "account.theme", "menu": ["Advanced"], "note": "Theme › Interface › Advanced"},
    {"op": "waitFor", "probe": "interfaceMode", "equals": "advanced"},
    {"op": "waitFor", "label": "Automation", "window": "main", "exists": true, "note": "the Advanced items are back"},
    {"op": "assert", "label": "Model", "window": "main", "exists": true},
    {"op": "assert", "label": "Trigger", "window": "main", "exists": true},
    {"op": "key", "key": "escape"},
    {"op": "wait", "ms": 500},
    {"op": "screenshot", "name": "advanced"}
  ]
}
