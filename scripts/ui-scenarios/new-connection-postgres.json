{
  "name": "new-connection-postgres",
  "requires": ["postgres"],
  "args": ["--window-size", "1400x900"],
  "steps": [
    {"op": "wait", "ms": 500},
    {"op": "key", "key": "n", "modifiers": ["cmd"], "note": "⌘N: New Connection"},
    {"op": "waitFor", "label": "PostgreSQL", "window": "sheet", "exists": true, "timeout": 5},
    {"op": "click", "label": "PostgreSQL", "window": "sheet", "index": 0, "note": "pick the PostgreSQL tile"},
    {"op": "click", "label": "Next", "role": "AXButton", "window": "sheet"},
    {"op": "waitFor", "id": "connection.host", "exists": true},
    {"op": "type", "target": {"id": "connection.name"}, "text": "UI PG", "replace": true},
    {"op": "type", "target": {"id": "connection.host"}, "text": "127.0.0.1", "replace": true},
    {"op": "type", "target": {"id": "connection.port"}, "text": "55432", "replace": true},
    {"op": "type", "target": {"id": "connection.user"}, "text": "postgres", "replace": true},
    {"op": "type", "target": {"id": "connection.password"}, "text": "wrong-password"},
    {"op": "type", "target": {"id": "connection.database"}, "text": "uitest", "replace": true},
    {"op": "click", "label": "Test Connection", "role": "AXButton", "window": "sheet", "note": "a wrong password fails"},
    {"op": "waitFor", "labelContains": "password authentication failed", "window": "sheet", "exists": true, "timeout": 15},
    {"op": "type", "target": {"id": "connection.password"}, "text": "uitest-pass", "replace": true},
    {"op": "click", "label": "Test Connection", "role": "AXButton", "window": "sheet"},
    {"op": "waitFor", "labelContains": "Connection Successful", "window": "sheet", "exists": true, "timeout": 15, "note": "Test Connection succeeds"},
    {"op": "screenshot", "name": "tested"},
    {"op": "click", "label": "OK", "role": "AXButton", "window": "sheet", "note": "OK saves and connects"},
    {"op": "waitFor", "sheet": true, "equals": "false"},
    {"op": "waitFor", "probe": "connections", "contains": "UI PG"},
    {"op": "assert", "probe": "file:$RUN/data/connections.json", "notContains": "uitest-pass", "note": "the password is not in connections.json"},
    {"op": "waitFor", "probe": "openSessions", "equals": 1, "timeout": 15},
    {"op": "waitFor", "id": "nav.toggle.Tables", "exists": true, "timeout": 10, "note": "database and schema expanded"},
    {"op": "click", "id": "nav.toggle.Tables"},
    {"op": "waitFor", "label": "customers", "role": "AXStaticText", "exists": true, "timeout": 10},
    {"op": "doubleClick", "label": "customers", "role": "AXStaticText", "index": 0},
    {"op": "waitFor", "probe": "tab.rowCount", "equals": 50, "timeout": 15, "note": "the PostgreSQL table opens"},
    {"op": "screenshot", "name": "table"}
  ]
}
