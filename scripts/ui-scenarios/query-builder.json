{
  "name": "query-builder",
  "args": ["{{DB}}", "--query", "", "--query-builder", "--window-size", "1400x900"],
  "steps": [
    {"op": "waitFor", "sheet": true, "equals": "true", "note": "Query Builder sheet open"},
    {"op": "waitFor", "probe": "qb.objects.count", "atLeast": 2},
    {"op": "dump", "name": "tree"},
    {"op": "assert", "view": "QueryBuilderCanvasView", "attribute": "frame", "notContains": "{0, 0}}", "note": "regression: the diagram was 0×0 until the model changed, so the first drop failed"},
    {"op": "dragDrop", "payload": "bunnygrid.querybuilder.table:customers", "to": {"view": "QueryBuilderCanvasView", "at": [0, 0], "offset": [80, 40]}, "note": "drag customers onto the diagram"},
    {"op": "dragDrop", "payload": "bunnygrid.querybuilder.table:orders", "to": {"view": "QueryBuilderCanvasView", "at": [0, 0], "offset": [420, 60]}, "note": "drag orders onto the diagram"},
    {"op": "waitFor", "probe": "qb.query.tables.count", "equals": 2},
    {"op": "waitFor", "probe": "qb.query.tables.name", "equals": "customers|orders"},
    {"op": "wait", "ms": 500, "note": "columns and foreign keys load"},
    {"op": "screenshot", "name": "tables"},
    {"op": "remember", "as": "joins", "probe": "qb.query.joins.count"},
    {"op": "drag", "from": {"view": "QueryBuilderCanvasView", "anchor": "column:orders.status"}, "to": {"view": "QueryBuilderCanvasView", "anchor": "column:customers.city"}, "note": "drag orders.status onto customers.city"},
    {"op": "waitFor", "probe": "qb.query.joins.rightColumn", "contains": "city"},
    {"op": "assert", "probe": "qb.query.joins.count", "notEquals": "$joins"},
    {"op": "screenshot", "name": "joined"},
    {"op": "remember", "as": "position", "view": "QueryBuilderCanvasView"},
    {"op": "drag", "from": {"view": "QueryBuilderCanvasView", "anchor": "table:orders"}, "by": [60, 120], "note": "move the orders box by its header"},
    {"op": "assert", "view": "QueryBuilderCanvasView", "notEquals": "$position"},
    {"op": "click", "view": "QueryBuilderCanvasView", "anchor": "badge:0", "menu": ["Left Join"], "note": "join badge menu → Left Join"},
    {"op": "waitFor", "probe": "qb.query.joins.0.kind", "equals": "left"},
    {"op": "rightClick", "view": "QueryBuilderCanvasView", "anchor": "table:customers", "menu": ["Select All Columns"], "note": "table context menu"},
    {"op": "waitFor", "probe": "qb.query.columns.column", "contains": "email"},
    {"op": "click", "view": "QueryBuilderCanvasView", "anchor": "check:customers.email", "note": "uncheck email"},
    {"op": "waitFor", "probe": "qb.query.columns.column", "notContains": "email"},
    {"op": "click", "label": "<Click here to add fields>", "index": 0, "menu": ["orders", "total"], "note": "SELECT add-field menu"},
    {"op": "waitFor", "probe": "qb.query.columns.column", "contains": "total"},
    {"op": "click", "label": "<Click here to add conditions>", "index": 0, "note": "WHERE + condition"},
    {"op": "waitFor", "probe": "qb.query.whereClause.items.count", "equals": 1},
    {"op": "click", "label": "<Click here to add fields>", "index": 2, "menu": ["customers", "name"], "note": "ORDER BY add-field menu"},
    {"op": "waitFor", "probe": "qb.query.orderBy.count", "equals": 1},
    {"op": "type", "target": {"label": "<Click here to set limit>"}, "text": "25", "note": "LIMIT"},
    {"op": "waitFor", "probe": "qb.query.limit", "equals": 25},
    {"op": "waitFor", "probe": "qb.sql", "contains": "LEFT JOIN"},
    {"op": "assert", "probe": "qb.sql", "contains": "LIMIT 25"},
    {"op": "screenshot", "name": "clauses"},
    {"op": "click", "label": "OK", "role": "button", "window": "sheet", "note": "OK writes the SQL into the editor"},
    {"op": "waitFor", "sheet": true, "equals": "false"},
    {"op": "waitFor", "probe": "tab.text", "contains": "LEFT JOIN"},
    {"op": "screenshot", "name": "editor"}
  ]
}
