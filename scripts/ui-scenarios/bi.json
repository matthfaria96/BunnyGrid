{
  "name": "bi",
  "args": ["{{DB}}", "--show-objects", "--window-size", "1500x950"],
  "steps": [
    {"op": "action", "name": "newBI", "table": "orders", "note": "BI workspace on orders"},
    {"op": "waitFor", "probe": "tab.workspace.charts.count", "equals": 1},
    {"op": "waitFor", "probe": "tab.workspace.sources.0.fields.name", "contains": "status", "note": "fields read"},
    {"op": "waitFor", "id": "bi.shelf.Axis", "exists": true, "note": "chart editor shown"},
    {"op": "dragDrop", "payload": "bi-field:status", "to": {"id": "bi.shelf.Axis"}, "note": "drag a dimension to Axis"},
    {"op": "waitFor", "probe": "tab.workspace.charts.0.dimensions.field", "equals": "status"},
    {"op": "dragDrop", "payload": "bi-count:", "to": {"id": "bi.shelf.Values"}, "note": "drag Count of Rows to Values"},
    {"op": "dragDrop", "payload": "bi-field:total", "to": {"id": "bi.shelf.Values"}, "note": "drag a measure to Values"},
    {"op": "waitFor", "probe": "tab.workspace.charts.0.measures.count", "equals": 2},
    {"op": "dragDrop", "payload": "bi-field:status", "to": {"id": "bi.shelf.Filters"}, "note": "drag a field to Filters"},
    {"op": "waitFor", "probe": "tab.workspace.charts.0.filters.count", "equals": 1},
    {"op": "waitFor", "probe": "tab.results.count", "atLeast": 1, "note": "the chart ran"},
    {"op": "assert", "probe": "tab.errors.count", "equals": 0},
    {"op": "screenshot", "name": "chart"},
    {"op": "click", "label": "New Dashboard", "note": "toolbar New Dashboard"},
    {"op": "waitFor", "probe": "tab.workspace.dashboards.count", "equals": 1},
    {"op": "waitFor", "id": "bi.dashboard", "exists": true},
    {"op": "remember", "as": "chart", "probe": "tab.workspace.charts.0.id"},
    {"op": "dragDrop", "payload": "bi-chart:$chart", "to": {"id": "bi.dashboard"}, "note": "drag the chart from the sidebar onto the dashboard"},
    {"op": "waitFor", "probe": "tab.workspace.dashboards.0.items.count", "equals": 1},
    {"op": "waitFor", "id": "bi.tile.Chart 1", "exists": true},
    {"op": "remember", "as": "x", "probe": "tab.workspace.dashboards.0.items.0.x"},
    {"op": "drag", "from": {"id": "bi.tile.Chart 1", "at": [0.3, 0], "offset": [0, 12]}, "by": [260, 0], "steps": 16, "release": false, "note": "drag the tile's title strip"},
    {"op": "screenshot", "name": "tile-dragging"},
    {"op": "release"},
    {"op": "waitFor", "probe": "tab.workspace.dashboards.0.items.0.x", "notEquals": "$x", "note": "moved and snapped to the grid"},
    {"op": "remember", "as": "w", "probe": "tab.workspace.dashboards.0.items.0.width"},
    {"op": "hover", "id": "bi.tile.Chart 1", "note": "hover shows the resize handle"},
    {"op": "wait", "ms": 300},
    {"op": "drag", "from": {"id": "bi.tile.Chart 1", "at": [1, 1], "offset": [-9, -9]}, "by": [-160, 0], "steps": 16, "note": "drag the resize corner"},
    {"op": "waitFor", "probe": "tab.workspace.dashboards.0.items.0.width", "notEquals": "$w"},
    {"op": "click", "id": "bi.addFilter", "menu": ["status"], "note": "dashboard filter"},
    {"op": "waitFor", "probe": "tab.workspace.dashboards.0.filters.count", "equals": 1},
    {"op": "screenshot", "name": "dashboard"}
  ]
}
