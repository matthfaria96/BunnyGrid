{
  "name": "servers-browse",
  "requires": ["mysql", "mongo", "redis"],
  "fixture": "servers",
  "args": ["--window-size", "1400x900"],
  "steps": [
    {"op": "waitFor", "id": "nav.toggle.UI MySQL", "exists": true},
    {"op": "click", "id": "nav.toggle.UI MySQL", "note": "expand MySQL: connects with the seeded password"},
    {"op": "waitFor", "id": "nav.toggle.Tables", "exists": true, "timeout": 15},
    {"op": "click", "id": "nav.toggle.Tables"},
    {"op": "waitFor", "label": "customers", "role": "AXStaticText", "exists": true, "timeout": 10},
    {"op": "doubleClick", "label": "customers", "role": "AXStaticText", "index": 0},
    {"op": "waitFor", "probe": "tab.rowCount", "equals": 2, "timeout": 15, "note": "MySQL table opens"},
    {"op": "screenshot", "name": "mysql"},
    {"op": "click", "id": "nav.toggle.UI MySQL", "note": "collapse it"},
    {"op": "click", "id": "nav.toggle.UI Mongo", "note": "expand MongoDB"},
    {"op": "waitFor", "label": "people", "role": "AXStaticText", "exists": true, "timeout": 15, "optional": true},
    {"op": "dump", "name": "mongo"},
    {"op": "waitFor", "id": "nav.toggle.Collections", "exists": true, "timeout": 10, "optional": true},
    {"op": "click", "id": "nav.toggle.Collections", "optional": true},
    {"op": "waitFor", "label": "people", "role": "AXStaticText", "exists": true, "timeout": 10},
    {"op": "doubleClick", "label": "people", "role": "AXStaticText", "index": 0, "note": "open the collection"},
    {"op": "waitFor", "probe": "tabTitle", "contains": "people", "timeout": 15},
    {"op": "screenshot", "name": "mongo"},
    {"op": "click", "id": "nav.toggle.UI Mongo"},
    {"op": "click", "id": "nav.toggle.UI Redis", "note": "expand Redis"},
    {"op": "waitFor", "id": "nav.toggle.db0", "exists": true, "timeout": 15},
    {"op": "click", "id": "nav.toggle.db0", "note": "expand db0"},
    {"op": "wait", "ms": 800},
    {"op": "dump", "name": "redis"},
    {"op": "waitFor", "labelContains": "greeting", "role": "AXStaticText", "exists": true, "timeout": 10, "optional": true},
    {"op": "click", "id": "nav.toggle.uitest", "optional": true, "note": "key folder"},
    {"op": "waitFor", "labelContains": "greeting", "role": "AXStaticText", "exists": true, "timeout": 10},
    {"op": "doubleClick", "labelContains": "greeting", "role": "AXStaticText", "index": 0, "note": "open the key"},
    {"op": "waitFor", "probe": "tabKind", "equals": "redis", "timeout": 10},
    {"op": "waitFor", "labelContains": "hello", "exists": true, "timeout": 10, "note": "the value is shown"},
    {"op": "screenshot", "name": "redis"}
  ]
}
