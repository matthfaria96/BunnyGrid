{
  "name": "import-export-documents",
  "args": ["{{DB}}", "--window-size", "1400x900"],
  "files": {"in.xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<RECORDS>\n<RECORD>\n<name>Xml One</name>\n<email>xml1@example.com</email>\n<city>Recife</city>\n</RECORD>\n<RECORD>\n<name>Xml Two</name>\n<email>xml2@example.com</email>\n<city><![CDATA[Natal & Co]]></city>\n</RECORD>\n</RECORDS>\n", "out/.keep": ""},
  "steps": [
    {"op": "waitFor", "probe": "openSessions", "equals": 1},
    {"op": "waitFor", "id": "nav.toggle.Tables", "exists": true},
    {"op": "click", "id": "nav.toggle.Tables"},
    {"op": "waitFor", "label": "customers", "role": "AXStaticText", "exists": true},
    {"op": "rightClick", "label": "customers", "role": "AXStaticText", "index": 0, "menu": ["Export Wizard…"]},
    {"op": "waitFor", "sheet": true, "equals": "true"},
    {"op": "click", "label": "Markdown", "role": "AXRadioButton", "window": "sheet", "note": "Format › Markdown"},
    {"op": "panel", "path": "$RUN/out"},
    {"op": "click", "label": "Export…", "role": "AXButton", "window": "sheet"},
    {"op": "waitFor", "sheet": true, "equals": "false", "timeout": 20},
    {"op": "waitFor", "probe": "file:$RUN/out/customers.md", "contains": "| c1@example.com |", "note": "Markdown table written"},
    {"op": "rightClick", "label": "customers", "role": "AXStaticText", "index": 0, "menu": ["Export Wizard…"]},
    {"op": "waitFor", "sheet": true, "equals": "true"},
    {"op": "click", "label": "XML", "role": "AXRadioButton", "window": "sheet", "note": "Format › XML"},
    {"op": "panel", "path": "$RUN/out"},
    {"op": "click", "label": "Export…", "role": "AXButton", "window": "sheet"},
    {"op": "waitFor", "sheet": true, "equals": "false", "timeout": 20},
    {"op": "waitFor", "probe": "file:$RUN/out/customers.xml", "contains": "<email>c1@example.com</email>"},
    {"op": "rightClick", "label": "customers", "role": "AXStaticText", "index": 0, "menu": ["Import Wizard…"]},
    {"op": "waitFor", "sheet": true, "equals": "true"},
    {"op": "click", "label": "XML", "window": "sheet", "index": 0, "note": "Import type › XML (segmented)"},
    {"op": "panel", "path": "$RUN/in.xml"},
    {"op": "click", "label": "Choose…", "role": "AXButton", "window": "sheet"},
    {"op": "waitFor", "label": "Import 2 Records", "role": "AXButton", "window": "sheet", "exists": true, "timeout": 10, "note": "Navicat-style XML parsed and mapped by name"},
    {"op": "screenshot", "name": "import-xml"},
    {"op": "click", "label": "Import 2 Records", "role": "AXButton", "window": "sheet"},
    {"op": "waitFor", "probe": "sql:$RUN/demo.sqlite|SELECT count(*) FROM customers WHERE email LIKE 'xml%'", "equals": "2", "timeout": 15},
    {"op": "assert", "probe": "sql:$RUN/demo.sqlite|SELECT city FROM customers WHERE email = 'xml2@example.com'", "equals": "Natal & Co"},
    {"op": "click", "label": "Close", "role": "AXButton", "window": "sheet"},
    {"op": "waitFor", "sheet": true, "equals": "false"}
  ]
}
