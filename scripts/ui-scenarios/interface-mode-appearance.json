{
  "name": "interface-mode-appearance",
  "args": ["--first-launch", "--window-size", "1400x900"],
  "steps": [
    {"op": "waitFor", "probe": "onboarding", "equals": "true"},
    {"op": "waitFor", "id": "onboarding.card.simple", "exists": true},
    {"op": "click", "label": "Dark", "window": "sheet", "note": "Appearance › Dark applies at once"},
    {"op": "waitFor", "probe": "appearance", "contains": "Dark"},
    {"op": "wait", "ms": 600, "note": "the window finishes turning dark"},
    {"op": "click", "id": "onboarding.card.simple"},
    {"op": "wait", "ms": 400},
    {"op": "screenshot", "name": "onboarding-dark"},
    {"op": "click", "id": "onboarding.continue"},
    {"op": "waitFor", "probe": "onboarding", "equals": "false"},
    {"op": "assert", "probe": "interfaceMode", "equals": "simple"},
    {"op": "assert", "probe": "appearance", "contains": "Dark", "note": "still dark after Continue"},
    {"op": "waitFor", "label": "Automation", "window": "main", "exists": false},
    {"op": "wait", "ms": 800, "note": "the sheet finishes closing"},
    {"op": "click", "id": "toolbar.account"},
    {"op": "waitFor", "id": "account.theme", "exists": true},
    {"op": "click", "id": "account.theme", "menu": ["Light"], "note": "Theme › Appearance › Light"},
    {"op": "waitFor", "probe": "appearance", "notContains": "Dark"},
    {"op": "click", "id": "account.theme", "menu": ["Dark"], "note": "and back to Dark"},
    {"op": "waitFor", "probe": "appearance", "contains": "Dark"},
    {"op": "key", "key": "escape"},
    {"op": "wait", "ms": 300},
    {"op": "key", "key": ",", "modifiers": ["cmd"], "note": "Settings in Simple mode"},
    {"op": "waitFor", "id": "settings.interfaceMode", "exists": true, "timeout": 5},
    {"op": "assert", "label": "Code Completion", "window": "settings", "exists": false, "note": "advanced pages hidden"},
    {"op": "assert", "label": "Auto Recovery", "window": "settings", "exists": false},
    {"op": "assert", "label": "Records", "window": "settings", "exists": true},
    {"op": "wait", "ms": 300},
    {"op": "screenshot", "name": "settings-simple"}
  ]
}
