# Copy to scripts/release.env (gitignored) and fill in. Variables already exported in the shell win.
# Without any of these, scripts/release.sh still builds an ad hoc signed app and DMG.

# Developer ID Application certificate (`security find-identity -v -p codesigning` shows the exact name).
#BUNNYGRID_SIGN_IDENTITY=Developer ID Application: Your Name (ABCDE12345)

# Profile saved by: xcrun notarytool store-credentials bunnygrid-notary --apple-id you@example.com --team-id ABCDE12345
#BUNNYGRID_NOTARY_PROFILE=bunnygrid-notary

# Sparkle updates: both must be set, or the app has no updater and no "Check for Updates…" item.
#BUNNYGRID_SPARKLE_FEED_URL=https://example.com/bunnygrid/appcast.xml
#BUNNYGRID_SPARKLE_PUBLIC_KEY=base64-public-key-printed-by-scripts/appcast.sh-generate-keys
# Optional: DMGs served somewhere other than next to appcast.xml.
#BUNNYGRID_SPARKLE_DOWNLOAD_PREFIX=https://github.com/you/bunnygrid/releases/download/v1.0.0/
# Optional (CI): private EdDSA key file instead of the login keychain.
#BUNNYGRID_SPARKLE_PRIVATE_KEY_FILE=/path/to/sparkle-private-key.txt

#BUNNYGRID_COPYRIGHT=Copyright © 2026 Your Name. All rights reserved.
